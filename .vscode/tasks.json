  "tasks": [
    {
      "label": "Tests: All (Docker 8.5)",
      "type": "shell",
      "command": "docker",
      "args": [
        "exec",
        "-w",
        "/var/www/html",
        "-e",
        "APP_ENV=testing",
        "-e",
        "DB_CONNECTION=sqlite",
        "-e",
        "DB_DATABASE=:memory:",
        "pizzareader-php-fpm-tests85-1",
        "sh",
        "-c",
        "php artisan config:clear && php artisan test"
      ],
      "group": "test",
      "problemMatcher": []
    },
